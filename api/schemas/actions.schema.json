{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket2d.dev/schemas/actions.schema.json",
  "title": "Pocket2D semantic actions (actions.json)",
  "description": "Optional project file loaded by ActionMap::Load (src/engine/input/ActionMap.cpp). Unknown top-level and action members are ignored by the loader and allowed here, including binding fields that belong to another action type. Not expressible here: key names must be known SDL key or scancode names, and action names are limited to 64 UTF-8 bytes in the loader but characters here.",
  "type": "object",
  "required": [
    "version",
    "actions"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "actions": {
      "description": "Actions by name (1..64 bytes).",
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "keys": {
      "description": "At most 16 SDL key names (validated by Input::IsKnownKeyName).",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string"
      }
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "button",
            "axis",
            "axis2d"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "properties": {
              "keys": {
                "$ref": "#/$defs/keys"
              },
              "mouse": {
                "description": "Mouse buttons: 1 left, 2 middle, 3 right.",
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "axis"
              }
            }
          },
          "then": {
            "properties": {
              "negative": {
                "$ref": "#/$defs/keys"
              },
              "positive": {
                "$ref": "#/$defs/keys"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "axis2d"
              }
            }
          },
          "then": {
            "properties": {
              "left": {
                "$ref": "#/$defs/keys"
              },
              "right": {
                "$ref": "#/$defs/keys"
              },
              "up": {
                "$ref": "#/$defs/keys"
              },
              "down": {
                "$ref": "#/$defs/keys"
              }
            }
          }
        }
      ]
    }
  }
}
