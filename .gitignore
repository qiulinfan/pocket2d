# Build trees: CMake presets, runtime kits, packages, benchmarks and captures.
/build/
# make site-build
/.site/
# make compile-commands, for clangd
/compile_commands.json

# Written by the engine at run time: project caches, the per-user settings
# fallback when no home folder is known, Dear ImGui layouts and the legacy
# input recording and render log.
.pocketengine/
/.engine/user/
imgui.ini
sdl_user_input.txt
recorded_sdl_user_input.txt
render_logger.txt

# Compiled binaries belong in build/, never in Git.
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.app
*.dSYM/

# Media and archives stay out unless listed below: game art and audio are
# often not redistributable. The upper-case patterns also match lower-case
# names where Git ignores case (the macOS default).
*.PNG
*.JPG
*.jpeg
*.JPEG
*.bmp
*.BMP
*.gif
*.GIF
*.mp3
*.MP3
*.wav
*.ogg
*.raw
*.mp4
*.mov
*.pdf
*.fbx
*.meta
*.zip
!/docs/*.png
!/docs/show.gif
!/docs/showcase/*.png
!/.engine/system/*.png
!/.engine/templates/*/images/*.png
# Self-authored, reproducible test geometry is part of the runnable fixtures.
!/tests/fixtures/*/images/**/*.bmp
!/tests/fixtures/*/images/**/*.png

# Tool caches and logs
__pycache__/
*.pyc
node_modules/
*.log
*.tmp

# Personal editor, IDE, agent and OS files
.vscode/
.idea/
.obsidian/
.vs/
*.code-workspace
.history/
xcuserdata/
.claude/
.codex
.DS_Store
*~
